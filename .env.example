# ===== FRONTEND (Vite) =====
# Salin ke .env untuk lokal, atau set di Vercel > Environment Variables.
# Prefix VITE_* berarti variabel ini DI-BAKE ke dalam bundle saat `vite build`.
# Mengubahnya di Vercel WAJIB diikuti redeploy — env var tidak berefek runtime.

# Supabase (aman dipublikasikan — anon key memang diperuntukkan untuk client)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Base URL API Express.
#   Lokal   : http://localhost:3001/api
#   Produksi: https://<nama-project>.vercel.app/api
VITE_API_URL=http://localhost:3001/api

# Midtrans Snap. Sandbox -> false, Produksi -> true (Wajib ikut key produksi).
VITE_MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxx
VITE_MIDTRANS_IS_PRODUCTION=false
