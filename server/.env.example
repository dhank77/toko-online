# ===== BACKEND (Express) =====
# Salin ke server/.env untuk lokal, atau set di Vercel > Environment Variables.
# Tanpa prefix VITE_* — variabel ini hanya dibaca di server, TIDAK ke bundle frontend.
# JANGAN pernah memberikan service role key ke frontend.

# Port untuk development lokal. Di Vercel ini diabaikan (ditentukan Vercel).
PORT=3001

# Origin frontend yang diizinkan oleh CORS. Pisahkan dengan koma untuk
# beberapa domain, contoh:
#   FRONTEND_URL=http://localhost:5173,https://toko.vercel.app
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# --- Supabase (server-side, memakai service role = melewati RLS) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- JWT ---
# Opsional. Isi dengan JWT Secret Supabase yang ASLI (Settings > API > JWT Secret)
# agar verifikasi token bisa dilakukan lokal tanpa network round-trip.
# Jika dikosongkan atau salah, server otomatis jatuh ke verifikasi remote.
JWT_SECRET=

# --- Midtrans ---
# Sandbox: false + key sandbox. Produksi: true + key produksi.
MIDTRANS_MERCHANT_ID=M-000000000
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxx
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# --- Opsional ---
# false untuk mematikan rate limiter (tidak disarankan di produksi)
RATE_LIMIT_ENABLED=true


